{
  "name": "agentd",
  "version": "0.1.0",
  "private": true,
  "description": "Familiar in-machine daemon: browser, terminal, executors",
  "type": "module",
  "bin": {
    "agentd": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && chmod +x dist/main.js dist/mcp.js",
    "start": "node dist/main.js",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=300000 dist/test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.56.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9"
  }
}
