# Familiar configuration. Copy to .env; everything is optional.
# With nothing set, `./scripts/demo.sh` runs fully offline with the scripted executor.

# --- Coordinator (the agent you talk to) ---
# claude     = Claude Code on your subscription (default when `claude` is on PATH and logged in)
# openrouter = an OpenRouter chat model with tools (needs OPENROUTER_API_KEY)
# mock       = built-in rules, no model
FAMILIAR_COORDINATOR=
FAMILIAR_CLAUDE_MODEL=claude-opus-5-5
FAMILIAR_COORDINATOR_MODEL=anthropic/claude-opus-5.5

# --- Embeddings + OpenRouter ---
# google/gemini-embedding-2 at 3,072 dims (text, keyframes, voice). Without a key
# a local hashed embedding keeps search working; adding a key later re-embeds.
OPENROUTER_API_KEY=
FAMILIAR_EMBEDDING_MODEL=google/gemini-embedding-2
FAMILIAR_TRANSCRIBE_MODEL=google/gemini-3.8-flash

# --- Executor (who does the hands-on work on the machine) ---
# claude | codex | scripted (demo). Can be overridden per task ("use codex").
FAMILIAR_DEFAULT_EXECUTOR=claude

# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma separated. Message the bot once and it
# replies with your id if it's missing here.
TELEGRAM_ALLOWED_USERS=

# --- Web ---
FAMILIAR_PORT=4400
FAMILIAR_HOST=127.0.0.1
# Required when FAMILIAR_HOST isn't loopback. Open the UI once with /?token=<this>.
FAMILIAR_TOKEN=
# Your HTTPS URL (e.g. https://familiar.<tailnet>.ts.net via `tailscale serve`),
# used for "Watch live" buttons in Telegram.
FAMILIAR_PUBLIC_URL=
FAMILIAR_DATA_DIR=data

# --- Guardrails ---
FAMILIAR_APPROVAL_THRESHOLD_GBP=100

# --- Machines ---
# local      = agentd on this host, home in data/machines/<name>/home (default)
# docker     = image/ built as familiar-machine:latest, home in a Docker volume
# cloudflare = Sandbox SDK Worker in cloudflare/ (needs FAMILIAR_CF_WORKER_URL + FAMILIAR_CF_TOKEN + FAMILIAR_PUBLIC_WS_URL)
# ssh        = your own box over Tailscale (needs FAMILIAR_SSH_HOST + FAMILIAR_PUBLIC_WS_URL)
# manual     = don't launch anything; connect agentd yourself
FAMILIAR_MACHINE_BACKEND=local
FAMILIAR_MACHINE_NAME=errands
FAMILIAR_MAX_MACHINES=3
FAMILIAR_DOCKER_IMAGE=familiar-machine:latest
FAMILIAR_CF_WORKER_URL=
FAMILIAR_CF_TOKEN=
FAMILIAR_SSH_HOST=
FAMILIAR_PUBLIC_WS_URL=
